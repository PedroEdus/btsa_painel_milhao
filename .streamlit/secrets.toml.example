# Modelo dos Secrets do painel. NUNCA commitar o secrets.toml preenchido.
#
# Local  : o painel le do .env (python-dotenv). Este arquivo nao e usado.
# Cloud  : Streamlit Community Cloud -> Settings -> Secrets -> colar isto
#          preenchido. Nao existe .env la, entao as chaves AZURE_* sao
#          obrigatorias ou o carregamento do OneLake falha.
#
# Importante: escrever TUDO como string ("true", "20"). O Streamlit promove
# chaves de topo str/int/float para os.environ, mas NAO promove bool nativo do
# TOML — e o painel le tudo via os.getenv (config/settings.py, data/onelake.py).
# Ou seja: CUPOM_INCLUIR_CUSTAS = true (bool) seria ignorado; use "true".

# ── Service principal Azure AD — acesso ao OneLake / Fabric (OBRIGATORIO) ────
# Mesmos valores do .env local. Client secret e sensivel: so no cofre/Secrets.
AZURE_TENANT_ID = ""
AZURE_CLIENT_ID = ""
AZURE_CLIENT_SECRET = ""

# ── Janela de atualizacao ───────────────────────────────────────────────────
# Base do Fabric atualiza 8h e 15h (Brasilia). Margem em minutos apos o horario
# nominal p/ o pipeline terminar de gravar o snapshot. Default 20 (8h20/15h20).
ATUALIZACAO_MARGEM_MINUTOS = "20"

# ── Regra de cupom ──────────────────────────────────────────────────────────
# Custas entram no valor elegivel do cupom. Default "true".
CUPOM_INCLUIR_CUSTAS = "true"
# Meta de arrecadacao exibida no painel. "0" = sem meta definida.
META_ARRECADACAO = "0"
# Teto de cupons disponiveis. "0" = automatico (estima pelo potencial da base).
CUPONS_DISPONIVEIS = "0"

# ── Somente desenvolvimento ─────────────────────────────────────────────────
# Parquet local no formato bronze. Se preenchido, o painel IGNORA o OneLake.
# Nunca setar no Cloud.
# SNAPSHOT_LOCAL = "painel_milhao_snapshot.parquet"
